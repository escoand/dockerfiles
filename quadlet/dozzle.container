[Unit]
Description=Dozzle

[Container]
AutoUpdate=registry
ContainerName=dozzle
Environment=DOZZLE_AUTH_PROVIDER=simple
Environment=DOZZLE_ENABLE_ACTIONS=true
Environment=DOZZLE_ENABLE_SHELL=true
Environment=DOZZLE_REMOTE_HOST=tcp://journald-docker-proxy:2375
Environment=DOZZLE_NO_ANALYTICS=true
EnvironmentFile=/var/mnt/data/%N.env
HealthCmd=["/dozzle","healthcheck"]
HealthLogDestination=events_logger
Image=docker.io/amir20/dozzle:v11
Label=caddy={$DOMAIN_%N}
Label=caddy.reverse_proxy="{{upstreams 8080}}"
Network=podman
Network=backend.network
PodmanArgs=--cpus=0.5 --memory=256m --privileged
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
Volume=dozzle:/data

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
