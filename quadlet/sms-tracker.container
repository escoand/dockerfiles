[Unit]
Description=SMS Tracker

[Container]
AutoUpdate=local
ContainerName=sms-tracker
DropCapability=All
EnvironmentFile=/var/mnt/data/%N.env
HealthCmd=["deno","eval","try { await fetch('http://localhost:8000'); } catch { Deno.exit(1); }"]
Image=sms-tracker.build
Label=caddy={$DOMAIN_%N}
Label=caddy.@nonhook.not="path /api/receive"
Label=caddy.basic_auth=@nonhook
Label=caddy.basic_auth.{$TRACKER_USER}={$TRACKER_PASSWORD}
Label=caddy.reverse_proxy="{{upstreams 8000}}"
Label=dev.dozzle.group=sites
Network=podman
NoNewPrivileges=true
PodmanArgs=--cpus=1 --memory=128m
Pull=never
ReadOnly=true
Volume=sms-tracker:/app/data:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
